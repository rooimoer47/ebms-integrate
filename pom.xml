<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.ebms</groupId>
    <artifactId>ebms-msh</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ebms-msh</name>
    <description>ebMS 2.0 Message Service Handler</description>

    <properties>
        <java.version>21</java.version>
        <!-- Coverage floor. The target is 0.70/0.60 (story A2); branch sits below that until the
             Epic H test gaps are closed, so the gate is set at today's level and ratcheted up. -->
        <jacoco.version>0.8.15</jacoco.version>
        <sonar.maven.plugin.version>5.8.0.7211</sonar.maven.plugin.version>
        <jacoco.line.minimum>0.70</jacoco.line.minimum>
        <jacoco.branch.minimum>0.55</jacoco.branch.minimum>
        <!-- Analysis settings live here, not in sonar-project.properties: the Maven
             scanner reads the POM and ignores that file. -->
        <sonar.projectKey>ebms-msh</sonar.projectKey>
        <sonar.projectName>ebMS MSH</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.junit.reportPaths>${project.build.directory}/surefire-reports</sonar.junit.reportPaths>
        <sonar.coverage.exclusions>**/EbmsApplication.java,**/*Entity.java</sonar.coverage.exclusions>
        <!-- Cognitive complexity is suppressed only where the branchiness is inherent:
             MIME/XML parsing and serialisation driven by the ebMS 2.0 message structure.
             It used to be suppressed across ** , which hid the rule everywhere. -->
        <sonar.issue.ignore.multicriteria>cc</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.cc.ruleKey>java:S3776</sonar.issue.ignore.multicriteria.cc.ruleKey>
        <sonar.issue.ignore.multicriteria.cc.resourceKey>**/adapter/in/msh/SoapMime*.java</sonar.issue.ignore.multicriteria.cc.resourceKey>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Boot 4 split the auto-configurations out of spring-boot-autoconfigure
             into per-technology modules. These two are not pulled in by any starter we
             use: spring-boot-flyway configures Flyway, spring-boot-restclient supplies
             the RestClient.Builder that HttpMessageTransport injects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Jakarta Mail implementation (MIME parsing for SOAP with Attachments) -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <!-- YAML support for CPA configuration files (Jackson 3, matching Spring Boot 4) -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- Metrics: Spring Actuator + Prometheus registry -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- XML Digital Signatures (ebMS 2.0 signing and verification) -->
        <dependency>
            <groupId>org.apache.santuario</groupId>
            <artifactId>xmlsec</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- JMS / ActiveMQ Classic (optional: only used when ebms.jms.broker-url is set) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-activemq</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.6.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.maven.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <!-- test, not verify, so the documented `mvn package` still produces
                             target/site/jacoco. The gate below stays on verify. -->
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <!-- Bootstrap and JPA data carriers: no logic to cover, and leaving them in
                             the denominator only makes the number easier to game. -->
                        <exclude>dev/ebms/EbmsApplication.class</exclude>
                        <exclude>dev/ebms/adapter/out/persistence/*Entity.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
